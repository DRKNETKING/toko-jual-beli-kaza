    function setLanguage(lang) {

      const elements = document.querySelectorAll("[data-id]");

      elements.forEach(function(element) {

        const key = element.getAttribute("data-id");

        if (translations[lang][key] !== undefined) {

          element.innerHTML = translations[lang][key];

        }

      });


      document.documentElement.lang = lang;


      document.getElementById("idBtn")
        .classList.toggle("active", lang === "id");

      document.getElementById("enBtn")
        .classList.toggle("active", lang === "en");


      localStorage.setItem("warungLanguage", lang);

    }


    document.addEventListener("DOMContentLoaded", function() {

      const savedLanguage =
        localStorage.getItem("warungLanguage") || "id";

      setLanguage(savedLanguage);

    });

  </script>

