        promoText:
          "Hubungi kami melalui WhatsApp untuk informasi produk dan kebutuhan belanja Anda.",

        promoButton:
          "💬 Chat WhatsApp",

        portfolioBadge:
          "💻 Jasa Website",

        portfolioTitle:
          "Butuh Website Portfolio?",

        portfolioText:
          "Kami juga menyediakan jasa pembuatan website portfolio modern, profesional dan responsive untuk kebutuhan pribadi maupun usaha.",

        portfolioButton:
          "🚀 Konsultasi Website",

        aboutSmall:
          "Tentang Kami",

        aboutTitle:
          "Sederhana, Dekat dan Terpercaya",

        aboutText:
          "Warung Ridwan Saleh hadir untuk membantu memenuhi kebutuhan sehari-hari dengan pelayanan yang ramah dan mudah dihubungi.",

        contactSmall:
          "Hubungi Kami",

        contactTitle:
          "Siap Melayani Anda",

        contactText:
          "Silakan hubungi kami untuk informasi lebih lanjut.",

        phoneTitle:
          "WhatsApp",

        locationTitle:
          "Lokasi",

        locationText:
          "Lihat lokasi Warung Ridwan Saleh melalui Google Maps.",

        locationButton:
          "📍 Buka Maps",

        serviceTitle:
          "Jasa Website",

        serviceText:
          "Pembuatan website portfolio modern dan responsive.",

        finalTitle:
          "Ada yang ingin ditanyakan?",

        finalText:
